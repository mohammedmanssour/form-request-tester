{
  "name": "mohammedmanssour/form-request-tester",
  "version": "2.0.0",
  "description": "a collection of test helpers that help with testing form requests",
  "license": "MIT",
  "authors": [
    {
      "name": "Mohammed Manssour",
      "email": "manssour.mohammed@gmail.com",
      "homepage": "https://mohammedmanssour.me"
    }
  ],
  "autoload": {
    "psr-4": {
      "MohammedManssour\\FormRequestTester\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MohammedManssour\\FormRequestTester\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.5",
    "illuminate/contracts": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0",
    "illuminate/support": "^13.0",
    "illuminate/validation": "^13.0",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^11.5.50|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^11.0"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
